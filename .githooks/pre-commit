#!/usr/bin/env bash
# Keeps eval changes in their own commits.
#
# A commit that changes the app (tool/src/main) and the tests that judge it (tool/src/test,
# eval/) at once is what weakening a test to make it pass looks like. Split, every test
# change is its own commit in `git log`, where it can be reviewed on its own.
#
# Enabled per clone with:  git config core.hooksPath .githooks
# A human who means it can override once with:  ALLOW_MIXED_EVAL_COMMIT=1 git commit ...
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACDMR)
app=$(grep -E '^tool/src/main/' <<<"$staged" || true)
evals=$(grep -E '^(tool/src/test/|eval/)' <<<"$staged" | grep -vE '^eval/out/' || true)

if [[ -n "$app" && -n "$evals" && "${ALLOW_MIXED_EVAL_COMMIT:-}" != "1" ]]; then
    echo "pre-commit: this commit changes the app and its tests together." >&2
    echo >&2
    echo "  app:" >&2;   sed 's/^/    /' <<<"$app" >&2
    echo "  tests:" >&2; sed 's/^/    /' <<<"$evals" >&2
    echo >&2
    echo "Commit them separately, so a change to a test is reviewed on its own." >&2
    echo "Override (humans only): ALLOW_MIXED_EVAL_COMMIT=1 git commit ..." >&2
    exit 1
fi
